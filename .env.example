# -- Django ----------------------------------------------------------------
DEBUG=0
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=dev-only-placeholder-not-a-real-secret-change-me-before-production-8f3a91c2e7d4b60542
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.localhost
DJANGO_LOG_SQL=0

# -- Database (PostgreSQL 16) ---------------------------------------------
DB_NAME=study_tracker
DB_USER=study_tracker
DB_PASSWORD=study_tracker
DB_HOST=127.0.0.1
DB_PORT=5432

# -- Redis (cache db=1, celery broker/result db=0) -------------------------
REDIS_URL=redis://127.0.0.1:6379

# -- Celery / Celery Beat --------------------------------------------------
CELERY_WORKER_CONCURRENCY=2

# -- Sentry (leave empty to disable) ---------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# -- CORS (comma separated, no spaces) -------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

